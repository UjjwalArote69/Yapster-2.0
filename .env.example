# ── Postgres (docker compose) ───────────────────────────────────
POSTGRES_USER=yapster
POSTGRES_PASSWORD=yapster
POSTGRES_DB=yapster

# ── API ─────────────────────────────────────────────────────────
APP_ENV=dev
# Local dev against the compose db. Inside compose the host is "db".
# Hosted Postgres URLs (Neon, Render, Supabase) can be pasted as-is: postgres:// and
# sslmode=require are converted for asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://yapster:yapster@localhost:5432/yapster
# The test suite uses this server (creates a throwaway yapster_test on it), never DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://yapster:yapster@localhost:5432/yapster
# JSON list of allowed web origins (add the Vercel URL in production)
CORS_ORIGINS=["http://localhost:3000"]
# Also accept any private-network origin (the phone on the hotspot). Set false in production.
CORS_ALLOW_PRIVATE_NETWORKS=true

# ── Google sign-in (optional; leave blank to hide the button) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register {PUBLIC_API_URL}/auth/google/callback in Google Cloud Console.
# Production: PUBLIC_API_URL=https://<service>.onrender.com, PUBLIC_WEB_URL=https://<app>.vercel.app
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:3000

# ── LLM (milestone 2; all free tiers) ───────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
# Provider chains, "provider:model" comma-separated, tried in order (see CLAUDE.md §11)
LLM_CHAT_CHAIN=gemini:gemini-3.5-flash-lite,groq:qwen/qwen3.8-27b,mistral:ministral-14b-latest
LLM_BATCH_CHAIN=gemini:gemini-3.8-flash,mistral:ministral-14b-latest,groq:openai/gpt-oss-120b

# ── Web ─────────────────────────────────────────────────────────
# Optional override. Leave unset locally: the web app calls the API on the same host it was
# loaded from (port 8000, or 8443 over HTTPS), which also works on a phone over the hotspot.
# On Vercel this is required: NEXT_PUBLIC_API_URL=https://<service>.onrender.com
# NEXT_PUBLIC_API_URL=http://localhost:8000